# Copy to .env and fill in. Never commit .env.

# --- Which network ---
# mainnet (PulseChain + Ethereum), or testnet (PulseChain Testnet v4 + Sepolia). Use a separate
# .env, wallet and state file for each.
NETWORK=mainnet

# --- The bot's wallet: the same address on both chains ---
# Needs, once: a little PLS on PulseChain and ETH on Ethereum, for gas (claiming a bridge message
# costs a few cents). After that it buys its own gas, with USDC it draws from the payments wallet's
# budget (see TREASURY below).
BOT_PRIVATE_KEY=
# Optional, and only used if buying from Ethereum is switched on (FILL=true). Opens the sealed
# details of each order. Leave it out and the bot makes it from BOT_PRIVATE_KEY, printing the public
# key (for the website) when it starts. To keep the two separate, make one with: npm run keygen
# BOT_ENCRYPTION_SECRET_KEY=

# --- Contracts: from the deploy workflow's job summaries ---
PULSECHAIN_REGISTRAR=
PULSECHAIN_HEX_REGISTRY=
PULSECHAIN_ORDER_FILLER=
PULSECHAIN_MIRROR_SYNC=
# AnyTokenCheckout. With it, once the admin chooses this bot as the copy bot on the admin page, the
# bot keeps the Ethereum copy fee up to date and copies names paid for at once. Without it (or with
# a checkout from before the copy fee), every copy is free.
PULSECHAIN_CHECKOUT=
ETHEREUM_ORDER_BOOK=
ETHEREUM_MIRROR_REGISTRAR=
# Where to start reading on a first run: START_BLOCK_PULSECHAIN from step 1, START_BLOCK_ETHEREUM
# from step 2.
START_BLOCK_PULSECHAIN=
START_BLOCK_ETHEREUM=
# On the testnet only: "USDC from Sepolia", PULSECHAIN_USDC from step 1. (On mainnet it is USDC
# bridged from Ethereum, filled in for you.)
# PULSECHAIN_USDC=

# --- Optional ---
# RPCs. Defaults: rpc.pulsechain.com and ethereum-rpc.publicnode.com on mainnet,
# rpc.v4.testnet.pulsechain.com and ethereum-sepolia-rpc.publicnode.com on the testnet.
# PULSECHAIN_RPC_URL=
# ETHEREUM_RPC_URL=
# Only used if buying from Ethereum is switched on (FILL=true): the least fee the bot takes per
# order, in USDC (websites must add at least this to the price), and how many Ethereum blocks it
# waits before acting on an order (12 seconds each).
# MIN_FEE_USDC=0.25
# ETHEREUM_CONFIRMATIONS=2
# POLL_SECONDS=5
# Where it remembers its place. On Railway it uses the attached volume by itself.
# STATE_FILE=./state.json
# Turn parts off: RELAY=false, SYNC=false, TREASURY=false. Filling orders placed on Ethereum is off
# unless FILL=true: names are bought on PulseChain, and the website doesn't offer Ethereum orders.
# These take true/false, 1/0, yes/no or on/off; anything else stops the bot with an error.
# Copying names to Ethereum costs the bot ETH. So that nobody can run that up by changing a name
# over and over, it copies each name at most once in RELAY_NAME_COOLDOWN_MINUTES (the newest change
# wins), and spends at most RELAY_DAILY_ETH a day copying names (0.02 ETH is about 1,100 copies at
# November 2026's gas prices). The rest wait until the next day (UTC).
# RELAY_NAME_COOLDOWN_MINUTES=60
# RELAY_DAILY_ETH=0.02
# The copy fee (with PULSECHAIN_CHECKOUT): the project pays up to COPY_FREE_USDC of each copy. When a
# copy costs more, the fee is the rest and a quarter more, and copies of new names and renewals
# nobody paid it for wait until a copy costs that or less again. Copies paid for, those the admin
# sends, and changes of owner don't wait; paid and admin copies aren't held by the limits above.
# COPY_FREE_USDC=2
# While the copy fee is on, the ETH the bot keeps for copies people pay for, bought only while copies
# are free (Ethereum is cheap). A claim needs its whole gas limit on hand (about 1.3 to 1.9 million
# gas, though it uses far less), so 0.02 ETH lets people pay to copy at once up to about 7 to 10
# gwei. When Ethereum is busier, paying the bot is paused: owners copy theirs themselves on Ethereum
# from the name's page, paying its fee in ETH, or wait for it to go free. Mainnet default shown; the
# testnet's is 0.002.
# COPY_NOW_ETH=0.02
# Its money (TREASURY): the USDC it keeps on PulseChain to buy gas with, and when and how much gas
# it buys. Mainnet defaults shown. Anything over FLOAT_USDC (plus a fifth, or $5) goes to the
# payments wallet; short of it, it draws from the payments wallet's budget, set in the app.
# FLOAT_USDC=20
# PLS_LOW=200000
# PLS_BUY_USDC=2
# ETH_LOW=0.003
# ETH_BUY_USDC=15
