# Netlify: the app lives at app.pdai.domains (add that domain to this Netlify site), where every
# page is the app's one page. On preview links it's under /app instead.

# The site's functions answer on every domain.
https://app.pdai.domains/api/*  /api/:splat  200

# app.pdai.domains: its front page and every name page are the app.
https://app.pdai.domains/  /app/index.html  200!
https://app.pdai.domains/*  /app/index.html  200

# On the live homepage the app is always on its own domain.
https://pdai.domains/app/*  https://app.pdai.domains/:splat  301!
https://www.pdai.domains/app/*  https://app.pdai.domains/:splat  301!

# Preview links: /app/alice.pdai and the like.
/app/*  /app/index.html  200
